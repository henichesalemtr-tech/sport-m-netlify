# ============================================================
# نظام إدارة رياضية — متغيرات البيئة (لا تضع أسرارًا حقيقية هنا)
# انسخ هذا الملف إلى .env واملأ القيم
# ============================================================

# بيئة التشغيل: development | production | test
NODE_ENV=development

# قاعدة البيانات (PostgreSQL مطلوب للإنتاج؛ SQLite للتطوير فقط — انظر docs/ASSUMPTIONS.md)
DATABASE_URL="postgresql://sms_user:sms_password@localhost:5432/sports_management?schema=public"

# أسرار التطبيق — ولّدها بأمر: openssl rand -hex 32
# يُستخدم لتوقيع كوكيز الجلسة ورموز QR (HMAC)
APP_SECRET="replace-with-64-hex-chars"
SESSION_SECRET="replace-with-64-hex-chars"

# الجلسة
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=24

# المنطقة الزمنية للمؤسسة (تُضبط أيضًا من الإعدادات داخل قاعدة البيانات)
APP_TIMEZONE="Africa/Algiers"

# تخزين الملفات (خارج المجلد العام)
STORAGE_DRIVER="local"              # local | s3
STORAGE_LOCAL_DIR="./storage/private"
STORAGE_MAX_IMAGE_MB=5
STORAGE_MAX_DOCUMENT_MB=10
# S3-Compatible (اختياري)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"

# البريد (SMTP) — معطّل افتراضيًا؛ انظر 7.16
SMTP_ENABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@example.com"

# المصادقة الثنائية (TOTP) لـ Super Admin/Admin — اختيارية
TOTP_ENABLED=false
TOTP_ISSUER="Sports Management System"

# حماية Brute Force
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# المسح (Scan) — مهلة منع تكرار المسح بالثواني
SCAN_DEDUP_SECONDS=10

# النسخ الاحتياطي
BACKUP_DIR="./storage/backups"
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6

# المراقبة
LOG_LEVEL="info"                    # debug | info | warn | error
ENABLE_CSP=true

# عنوان التطبيق (للـ CORS وروابط المطلقة)
APP_URL="http://localhost:3000"
