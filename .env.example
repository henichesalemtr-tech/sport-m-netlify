# ============================================================
# نظام إدارة رياضية — متغيرات البيئة (لا تضع أسرارًا حقيقية هنا)
# انسخ هذا الملف إلى .env واملأ القيم
# ============================================================

# بيئة التشغيل: يديرها Next تلقائيًا حسب الأمر (dev→development، build→production).
# لا تضبط NODE_ENV هنا: ضبطه في ملف .env يمنع "next build" من العمل بالوضع الإنتاجي
# ويحمّل React بنسخة التطوير، فينهار التمهير المسبق (prerender) للمسارات المدمجة.

# قاعدة البيانات: MySQL/MariaDB محلية (XAMPP). أنشئ القاعدة أولًا:
#   mysql -u root -e "CREATE DATABASE sports_management CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
DATABASE_URL="mysql://root@localhost:3306/sports_management"
# قاعدة بعيدة (MySQL 8 مثل Aiven): أضف sslaccept=accept_invalid_certs إلى الرابط.
# السبب: Prisma 5.22 مع MySQL يتجاهل ssl-mode/sslmode ويترك الاتصال نصيًا (مُجرَّب على Aiven).

# أسرار التطبيق — 32 حرفًا على الأقل؛ ولّدها مثلًا بأمر: openssl rand -hex 32
# يُستخدم لتوقيع كوكيز الجلسة ورموز QR (HMAC)
APP_SECRET="replace-with-64-hex-chars"
SESSION_SECRET="replace-with-64-hex-chars"

# الجلسة
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=24

# المنطقة الزمنية للمؤسسة (تُضبط أيضًا من الإعدادات داخل قاعدة البيانات)
APP_TIMEZONE="Africa/Algiers"

# تخزين الملفات (خارج المجلد العام)
STORAGE_DRIVER="local"              # local | s3
STORAGE_LOCAL_DIR="./storage/private"
STORAGE_MAX_IMAGE_MB=5
STORAGE_MAX_DOCUMENT_MB=10
# S3-Compatible (اختياري)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"

# البريد (SMTP) — معطّل افتراضيًا؛ انظر 7.16
SMTP_ENABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@example.com"

# المصادقة الثنائية (TOTP) لـ Super Admin/Admin — اختيارية
TOTP_ENABLED=false
TOTP_ISSUER="Sports Management System"

# حماية Brute Force
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# المسح (Scan) — مهلة منع تكرار المسح بالثواني
SCAN_DEDUP_SECONDS=10

# النسخ الاحتياطي
BACKUP_DIR="./storage/backups"
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
# تعطيل مهمة النسخ المجدولة حيث لا أدوات MySQL على النظام (دوال Netlify السيرفرية):
# BACKUP_JOB_ENABLED=false

# المهام المجدولة (إبطال الاشتراكات، توليد الإشعارات، الوثائق القريبة، النسخ، التصحيح)
# على خادم دائم: المجدول داخل العملية كافٍ. على بيئة سيرفرless (Netlify): اضبط
# JOBS_IN_PROCESS=false وفعّل دالة cron في netlify/functions مع CRON_SECRET مشترك.
# JOBS_IN_PROCESS=true
# JOBS_INTERVAL_MINUTES=15
# CRON_SECRET=                      # 16 حرفًا على الأقل؛ غيابه يُغلق /api/v1/jobs/run (503)

# المراقبة
LOG_LEVEL="info"                    # debug | info | warn | error

# عنوان التطبيق (للـ CORS وروابط المطلقة)
APP_URL="http://localhost:3000"

# أدوات النسخ الاحتياطي — اضبط مسارها إن لم تكن في PATH
# مثال XAMPP: C:\xampp\mysql\bin\mysqldump.exe (اتركها افتراضية إن كانت الأوامر متاحة)
MYSQLDUMP_BIN=mysqldump
MYSQL_BIN=mysql

# ------------------------------------------------------------
# الزراعة (seed) واختبارات E2E — كل هذا اختياري للاستخدام المحلي
# ------------------------------------------------------------
# `npm run seed` ينشئ أول Super Admin فقط عند ضبط هذين، وإلا يزرع البيانات المرجعية وحدها.
# اتركها معلّمة هنا (لا أسرار في هذا الملف) واملأها في .env عند الحاجة:
# SEED_ADMIN_EMAIL=admin@club.local
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_FULL_NAME=مدير النظام
#
# اختبارات Playwright: لا تحتاج أي سرّ في .env — الافتراضي هو حساب `npm run seed:demo`
# (admin@demo.test) بثابتيه المنشورين في scripts/seed-demo.ts. للتحكم اليدوي:
# E2E_PASSWORD=            # كلمة المرور التي يثبّتها الاختبار عند تغيير إجباري
# ومتغيرا SEED_ADMIN_* أعلاه يعملان مع الاختبارات أيضًا إن ضبطتهما.

